<Window x:Class="Adv2Obj.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ADV to OBJ Converter" Height="680" Width="940"
        MinHeight="560" MinWidth="760" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="#F5F7FB" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="#C9D2E3" />
            <Setter Property="Background" Value="White" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="ADV to OBJ Converter" FontSize="28" FontWeight="Bold" Foreground="#17233C" />
                <TextBlock Text="Batch-convert ADV files into complete OBJ/CSV/INI folders."
                           Margin="0,6,0,0" FontSize="14" Foreground="#5D6B82" />
            </StackPanel>
            <Image Grid.Column="1" Source="pack://application:,,,/Assets/logo.png"
                   Width="86" Height="78" Stretch="Uniform" HorizontalAlignment="Right" />
        </Grid>

        <Grid x:Name="InputControls" Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="115" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Input folder" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#26344D" />
            <TextBox x:Name="InputFolderTextBox" Grid.Column="1" Margin="0,0,10,0" IsReadOnly="True" />
            <Button Grid.Column="2" Content="Browse…" Click="BrowseInput_Click" />
        </Grid>

        <Grid x:Name="OutputControls" Grid.Row="2" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="115" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Output folder" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#26344D" />
            <TextBox x:Name="OutputFolderTextBox" Grid.Column="1" Margin="0,0,10,0" IsReadOnly="True" />
            <Button Grid.Column="2" Content="Browse…" Click="BrowseOutput_Click" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="DeleteAfterConversionCheckBox" Grid.ColumnSpan="3"
                      Content="Delete after conversion" IsChecked="True"
                      Margin="0,0,0,12" Foreground="#26344D"
                      ToolTip="Delete input ADV files only after successful conversion. Failed or cancelled inputs are kept." />
            <ProgressBar x:Name="ConversionProgress" Grid.Row="1" Height="18" Minimum="0" Maximum="1"
                         VerticalAlignment="Center" Foreground="#3167E3" />
            <Button x:Name="ConvertButton" Grid.Row="1" Grid.Column="1" Margin="18,0,0,0"
                    MinWidth="130" Content="Convert" Foreground="White" Background="#3167E3"
                    BorderBrush="#2857C5" Click="Convert_Click" />
            <Button x:Name="CancelButton" Grid.Row="1" Grid.Column="2" Margin="8,0,0,0"
                    Content="Cancel" IsEnabled="False" Click="Cancel_Click" />
        </Grid>

        <Border Grid.Row="4" Background="White" BorderBrush="#D9E0EC" BorderThickness="1" CornerRadius="6">
            <DataGrid ItemsSource="{Binding Files}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      BorderThickness="0" RowHeaderWidth="0" AlternatingRowBackground="#F8FAFD">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ADV file" Binding="{Binding FileName}" Width="2*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                    <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="4*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="ToolTip" Value="{Binding Details}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock x:Name="SummaryText" Grid.Row="5" Margin="0,14,0,0"
                   Foreground="#5D6B82" Text="Choose an input and output folder to begin." />

        <Border Grid.Row="6" Margin="0,18,0,0" Padding="0,12,0,0"
                BorderBrush="#C9D2E3" BorderThickness="0,1,0,0">
            <TextBlock Text="2026 Swastik Technology - All Rights Reserved"
                       HorizontalAlignment="Center" Foreground="#5D6B82" FontSize="13" />
        </Border>
    </Grid>
</Window>
